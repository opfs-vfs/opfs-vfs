{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "react"],
  "jsPlugins": ["@shadcn/lint"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.astro/**",
    "apps/website/public/ai-assets/**",
    "**/test-results/**",
    "**/playwright-report/**",
    ".scratch/**",
    "**/.duckdb/**",
    "apps/website/public/vendor/duckdb/**",
    "apps/website/public/vendor/edgejs/**",
    "**/.packed/**"
  ],
  "rules": {
    "typescript/no-floating-promises": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "off",
    "react/immutability": "off",
    "react/no-children-prop": "off",
    "react/purity": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/static-components": "off",
    "react/use-memo": "off"
  },
  "overrides": [
    {
      "files": ["**/__tests__/**/*.test.ts", "**/__tests__/**/*.test.tsx"],
      "rules": {
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": ["**/__tests__/test-worker.ts"],
      "rules": {
        "typescript/no-base-to-string": "off"
      }
    },
    {
      "files": ["apps/website/src/**/*.tsx"],
      "rules": {
        "shadcn/no-restyle": [
          "error",
          {
            "allow": [
              "layout",
              "ai-jump-latest",
              "ai-send",
              "ai-starter",
              "explorer-toggle",
              "persistence-switch",
              "study-motion"
            ]
          }
        ],
        "shadcn/no-raw-colors": "error",
        "shadcn/no-arbitrary-values": ["error", { "allow": ["layout"] }]
      }
    },
    {
      "files": ["apps/website/src/components/ui/**/*.tsx"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": [
          "error",
          { "allow": ["layout", "rounded-[4px]", "ring-[3px]", "transition-[color,box-shadow]"] }
        ]
      }
    }
  ]
}
