{
  "name": "@opfs-vfs/devtools",
  "version": "0.3.0",
  "description": "Explore and manage OPFS VFS volumes with file previews, a shell, and debugging tools.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opfs-vfs/opfs-vfs.git",
    "directory": "packages/devtools"
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "storybook dev --port 4326 --host 127.0.0.1 --no-open --disable-telemetry --exact-port",
    "storybook": "storybook dev --port 4326 --host 127.0.0.1 --no-open --disable-telemetry --exact-port",
    "build-storybook": "storybook build --disable-telemetry",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts && vitest run",
    "build": "vite build && tsc -p tsconfig.lib.json",
    "test:browser": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@opfs-vfs/file-preview": "workspace:*",
    "jszip": "3.10.2",
    "just-bash": "3.6.0",
    "lucide-react": "1.72.0"
  },
  "devDependencies": {
    "@opfs-vfs/opfs-vfs": "workspace:*",
    "@storybook/react-vite": "10.6.7",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.7",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@opfs-vfs/opfs-vfs": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
