{
  "name": "@opfs-vfs/file-preview",
  "version": "0.1.1",
  "description": "Shared React file previews and virtualized text editor.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opfs-vfs/opfs-vfs.git",
    "directory": "packages/file-preview"
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/preview-policy.test.ts",
    "build": "vite build && tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "pdfjs-dist": "6.5.438",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
