{
  "name": "opfs-vfs-monorepo",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "oxlint --type-aware --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "deadcode": "fallow dead-code",
    "duplicates": "fallow dupes",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only && oxfmt",
    "release": "pnpm build && changeset publish",
    "benchmark:collect": "pnpm --filter @opfs-vfs/website... build && pnpm --filter @opfs-vfs/website preview --host localhost"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@shadcn/lint": "0.2.0",
    "fallow": "3.27.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.4.2"
}
