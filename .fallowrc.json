{
  "publicPackages": [
    "@opfs-vfs/opfs-vfs",
    "@opfs-vfs/devtools",
    "@opfs-vfs/file-preview",
    "@opfs-vfs/plugin-subscriptions",
    "@opfs-vfs/react"
  ],
  "ignoreExports": [
