  "entry": [
    "apps/website/src/components/docs/SiteTitle.astro",
    "apps/website/src/components/docs/Head.astro",
    "apps/website/src/workers/gemma-runtime.worker.ts",
    "apps/website/src/styles/docs.css",
    "packages/effect/examples/direct.ts",
    "packages/effect/examples/worker-session.ts",
    "packages/effect/tests/packed-worker-session.test.ts",
    "packages/effect/vitest.packed.config.ts",
    "examples/duckdb/main.ts",
    "packages/devtools/.storybook/middleware.mjs",
    "packages/plugin-subscriptions/scripts/test-packed.mjs",
    "packages/plugin-subscriptions/scripts/two-tab-load.mjs",
    "packages/plugin-subscriptions/vitest.packed.config.ts",
    "packages/plugin-subscriptions/tests/packed-consumer.ts",
    "packages/plugin-subscriptions/tests/packed-consumer-worker.ts",
    "packages/plugin-subscriptions/tests/packed-consumer-direct-worker.ts",
    "packages/plugin-subscriptions/tests/packed-direct.test.ts",
    "packages/plugin-subscriptions/tests/packed-worker-follower.test.ts",
    "packages/opfs-vfs/scripts/benchmark-worker-client.mjs",
    "packages/opfs-vfs/scripts/benchmark-worker-client.test.mjs",
    "packages/opfs-vfs/src/__tests__/benchmark-worker-client-page.ts",
    "packages/opfs-vfs/src/__tests__/benchmark-worker-client-sab-worker.ts",
    "packages/react/src/__tests__/benchmark-sdk-page.tsx"
  ],
  "ignoreDependencies": ["@webgpu/types", "tw-animate-css"],
  "ignorePatterns": [
    "apps/website/public/vendor/duckdb/**",
    "apps/website/public/vendor/edgejs/**",
    "apps/website/public/ai-assets/**",
    "docs/research/edgejs-live-opfs/**",
    "docs/benchmarks/react-sdk/issue-89-relay-probe/probe.mjs",
    "**/.packed/**"
