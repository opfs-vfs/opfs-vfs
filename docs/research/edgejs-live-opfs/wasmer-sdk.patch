--- /dev/null
+++ b/js/bindgen/src/sync_fs.rs
@@ -0,0 +1,137 @@
+//! Synchronous host callbacks. Only numeric IDs cross Wasm worker boundaries.
+use std::{io::{self, SeekFrom}, path::{Path, PathBuf}, pin::Pin, task::{Context, Poll}};
+use js_sys::{Array, Uint8Array};
+use serde::Deserialize;
+use virtual_fs::{AsyncRead, AsyncWrite, AsyncSeek, FileOpener, FileSystem, VirtualFile, FsError, Result, Metadata};
+use wasm_bindgen::prelude::*;
+
+#[wasm_bindgen]
+extern "C" {
+    #[wasm_bindgen(js_namespace = globalThis, js_name = __wasmerSyncFsCall, catch)]
+    fn host_call(id: u32, method: &str, args: &Array) -> std::result::Result<JsValue, JsValue>;
+}
+fn error(value: JsValue) -> FsError {
+    let code = js_sys::Reflect::get(&value, &"code".into()).ok().and_then(|v| v.as_string());
+    match code.as_deref() {
+        Some("EBADF") => FsError::InvalidFd,
+        Some("ENOSPC") => FsError::StorageFull,
+        Some("ETIMEDOUT") => FsError::TimedOut,
+        Some("ENOENT") => FsError::EntryNotFound,
+        Some("EEXIST") => FsError::AlreadyExists,
+        Some("EACCES" | "EPERM") => FsError::PermissionDenied,
+        Some("ENOTDIR") => FsError::BaseNotDirectory,
+        Some("EISDIR") => FsError::NotAFile,
+        Some("ENOTEMPTY") => FsError::DirectoryNotEmpty,
+        Some("EINVAL") => FsError::InvalidInput,
+        Some("ENOSYS" | "ENOTSUP") => FsError::Unsupported,
+        _ => FsError::IOError,
+    }
+}
+fn call(id: u32, method: &str, args: &[JsValue]) -> Result<JsValue> {
+    let array = Array::new();
+    for arg in args { array.push(arg); }
+    host_call(id, method, &array).map_err(error)
+}
+fn number(v: JsValue) -> Result<u64> {
+    v.as_f64().filter(|n| n.is_finite() && *n >= 0.0 && *n <= 9007199254740991.0 && n.fract() == 0.0).map(|n| n as u64).ok_or(FsError::InvalidInput)
+}
+fn path(p: &Path) -> Result<JsValue> {
+    let s = p.to_str().ok_or(FsError::InvalidInput)?;
+    if s.contains('\0') || s.contains('\\') || s.split('/').any(|x| x == "..") { return Err(FsError::InvalidInput); }
+    Ok(s.into())
+}
+#[derive(Deserialize)]
+struct Meta { kind: String, size: u64, #[serde(default)] accessed: f64, #[serde(default)] modified: f64, #[serde(default)] created: f64 }
+impl Meta {
+    fn convert(self) -> Result<Metadata> {
+        Ok(Metadata { ft: match self.kind.as_str() { "file" => virtual_fs::FileType::new_file(), "directory" => virtual_fs::FileType::new_dir(), _ => return Err(FsError::Unsupported) }, len: self.size, accessed: (self.accessed * 1e6) as u64, modified: (self.modified * 1e6) as u64, created: (self.created * 1e6) as u64 })
+    }
+}
+fn meta(value: JsValue) -> Result<Metadata> { serde_wasm_bindgen::from_value::<Meta>(value).map_err(|_| FsError::InvalidInput)?.convert() }
+#[derive(Debug)]
+pub struct SyncFileSystem(pub u32);
+impl FileOpener for SyncFileSystem {
+    fn open(&self, p: &Path, c: &virtual_fs::OpenOptionsConfig) -> Result<Box<dyn VirtualFile + Send + Sync>> {
+        let opts = js_sys::Object::new();
+        for (key, value) in [("read",c.read),("write",c.write),("append",c.append),("create",c.create),("createNew",c.create_new),("truncate",c.truncate)] {
+            js_sys::Reflect::set(&opts, &key.into(), &value.into()).map_err(error)?;
+        }
+        let fd = number(call(self.0,"open",&[path(p)?,opts.into()])?)?;
+        Ok(Box::new(SyncFile { id:self.0, fd, position:0, closed:false }))
+    }
+}
+impl FileSystem for SyncFileSystem {
+    fn readlink(&self, _: &Path) -> Result<PathBuf> { Err(FsError::Unsupported) }
+    fn metadata(&self, p: &Path) -> Result<Metadata> { meta(call(self.0,"metadata",&[path(p)?])?) }
+    fn symlink_metadata(&self, p: &Path) -> Result<Metadata> { self.metadata(p) }
+    fn read_dir(&self, p: &Path) -> Result<virtual_fs::ReadDir> {
+        #[derive(Deserialize)] struct Entry { name:String, #[serde(flatten)] meta:Meta }
+        let entries: Vec<Entry> = serde_wasm_bindgen::from_value(call(self.0,"readDir",&[path(p)?])?).map_err(|_| FsError::InvalidInput)?;
+        let mut result = Vec::new();
+        for e in entries {
+            if e.name.is_empty() || e.name == "." || e.name == ".." || e.name.contains('/') || e.name.contains('\\') { return Err(FsError::InvalidInput); }
+            result.push(virtual_fs::DirEntry { path:p.join(e.name), metadata:Ok(e.meta.convert()?) });
+        }
+        Ok(virtual_fs::ReadDir::new(result))
+    }
+    fn create_dir(&self, p: &Path) -> Result<()> { call(self.0,"createDir",&[path(p)?]).map(|_|()) }
+    fn remove_dir(&self, p: &Path) -> Result<()> { call(self.0,"removeDir",&[path(p)?]).map(|_|()) }
+    fn remove_file(&self, p: &Path) -> Result<()> { call(self.0,"removeFile",&[path(p)?]).map(|_|()) }
+    fn rename<'a>(&'a self, from: &'a Path, to: &'a Path) -> futures::future::BoxFuture<'a,Result<()>> { Box::pin(async move { call(self.0,"rename",&[path(from)?,path(to)?]).map(|_|()) }) }
+    fn new_open_options(&self) -> virtual_fs::OpenOptions<'_> { virtual_fs::OpenOptions::new(self) }
+}
+#[derive(Debug)]
+struct SyncFile { id:u32, fd:u64, position:u64, closed:bool }
+impl SyncFile {
+    fn call(&self, method:&str, args:&[JsValue]) -> Result<JsValue> {
+        if self.closed { return Err(FsError::IOError); }
+        let mut all = vec![JsValue::from_f64(self.fd as f64)]; all.extend_from_slice(args);
+        call(self.id,method,&all)
+    }
+    fn stat(&self) -> Result<Metadata> { meta(self.call("fstat",&[])?) }
+    fn close(&mut self) -> Result<()> {
+        if self.closed { return Ok(()); }
+        let result=self.call("close",&[]).map(|_|()); self.closed=true; result
+    }
+}
+impl Drop for SyncFile { fn drop(&mut self) { let _=self.close(); } }
+impl AsyncRead for SyncFile {
+    fn poll_read(mut self:Pin<&mut Self>, _: &mut Context<'_>, b:&mut tokio::io::ReadBuf<'_>) -> Poll<io::Result<()>> {
+        let result=(|| {
+            let n=b.remaining().min(65536);
+            let value=self.call("read",&[(n as u32).into()])?;
+            if !value.is_instance_of::<Uint8Array>() { return Err(FsError::InvalidInput); }
+            let bytes=Uint8Array::new(&value).to_vec();
+            if bytes.len()>n { return Err(FsError::InvalidInput); }
+            b.put_slice(&bytes); self.position+=bytes.len() as u64; Ok(())
+        })(); Poll::Ready(result.map_err(io::Error::from))
+    }
+}
+impl AsyncWrite for SyncFile {
+    fn poll_write(mut self:Pin<&mut Self>, _: &mut Context<'_>, b:&[u8]) -> Poll<io::Result<usize>> {
+        let result=(|| { let b=&b[..b.len().min(65536)]; let n=number(self.call("write",&[Uint8Array::from(b).into()])?)? as usize;
+            if n>b.len() { return Err(FsError::InvalidInput); } self.position+=n as u64; Ok(n) })();
+        Poll::Ready(result.map_err(io::Error::from))
+    }
+    fn poll_flush(self:Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> { Poll::Ready(self.call("flush",&[]).map(|_|()).map_err(io::Error::from)) }
+    fn poll_shutdown(mut self:Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> { Poll::Ready(self.close().map_err(io::Error::from)) }
+}
+impl AsyncSeek for SyncFile {
+    fn start_seek(mut self:Pin<&mut Self>, pos:SeekFrom) -> io::Result<()> {
+        let (offset,whence)=match pos { SeekFrom::Start(n)=>(n as f64,0), SeekFrom::Current(n)=>(n as f64,1), SeekFrom::End(n)=>(n as f64,2) };
+        if offset.abs()>9007199254740991.0 { return Err(io::ErrorKind::InvalidInput.into()); }
+        self.position=number(self.call("seek",&[offset.into(),whence.into()])?).map_err(io::Error::from)?; Ok(())
+    }
+    fn poll_complete(self:Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<u64>> { Poll::Ready(Ok(self.position)) }
+}
+impl VirtualFile for SyncFile {
+    fn last_accessed(&self)->u64 { self.stat().map(|m|m.accessed).unwrap_or(0) }
+    fn last_modified(&self)->u64 { self.stat().map(|m|m.modified).unwrap_or(0) }
+    fn created_time(&self)->u64 { self.stat().map(|m|m.created).unwrap_or(0) }
+    // The runtime trait cannot report a metadata error from these scalar accessors.
+    fn size(&self)->u64 { self.stat().map(|m|m.len).unwrap_or(0) }
+    fn set_len(&mut self,n:u64)->Result<()> { self.call("setLen",&[(n as f64).into()]).map(|_|()) }
+    fn unlink(&mut self)->Result<()> { self.call("unlink",&[]).map(|_|()) }
+    fn poll_read_ready(self:Pin<&mut Self>, _: &mut Context<'_>)->Poll<io::Result<usize>> { Poll::Ready(self.stat().map(|m|m.len.saturating_sub(self.position) as usize).map_err(io::Error::from)) }
+    fn poll_write_ready(self:Pin<&mut Self>, _: &mut Context<'_>)->Poll<io::Result<usize>> { Poll::Ready(Ok(65536)) }
+}
