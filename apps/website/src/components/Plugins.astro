            <path d="M245 118v-13a15 15 0 0 1 30 0v13" fill="none" stroke="#e7ecdd" stroke-width="5" stroke-linecap="round" />
            <rect x="237" y="116" width="46" height="36" rx="7" fill="#d3dfbf" stroke="none" />
            <path d="M260 130v10" stroke-width="4" stroke-linecap="round" />
            <g transform="translate(349 73)">
              <circle r="28" fill="#fafaf2" />
              <g class="biometric-scan plugin-motion" fill="none" stroke-width="2" stroke-linecap="round">
                <path d="M-17 4V0a17 17 0 0 1 34 0v4" />
                <path d="M-12 11V0a12 12 0 0 1 24 0v6c0 5-1 9-3 13" />
                <path d="M-7 17V0a7 7 0 0 1 14 0v6c0 6-1 11-4 16" />
                <path d="M-2 20V0a2 2 0 0 1 4 0v6c0 6-1 11-3 15" />
              </g>
            </g>
            <path class="lock-glint plugin-motion" d="M333 108v14m-7-7h14" stroke="#73947b" stroke-width="2" stroke-linecap="round" />
          </g>
        </svg>
      </div>
      <div class="plugin-copy">
        <p class="plugin-status"><span class="available-dot" aria-hidden="true"></span>Available <span aria-hidden="true">·</span> Premium</p>
        <h3 id="encryption-heading">Encryption plugin</h3>
        <p>Protect files stored on the device with encrypted volumes and passkey-based access. Available under separate premium terms.</p>
        <a href="/docs/plugins/#encryption">About encryption <span aria-hidden="true">→</span></a>
      </div>
    </article>
  </div>
  <aside class="sync-plan" aria-labelledby="cloud-sync-heading">
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 27a8 8 0 0 1-1-16 11 11 0 0 1 21-2 9 9 0 0 1 3 18" /><path d="M17 39V23m-5 5 5-5 5 5m9-6v17m-5-5 5 5 5-5" /></svg>
    <div><p class="plugin-status">Planned <span aria-hidden="true">·</span> Premium</p><h3 id="cloud-sync-heading">Cloud sync plugin</h3><p>A planned plugin to sync a local OPFS VFS volume with backend cloud storage.</p></div>
    <a href="/docs/plugins/#cloud-sync">See what's planned <span aria-hidden="true">→</span></a>
  </aside>
</section>

<script>
  const plugins = document.querySelector<HTMLElement>('#plugins');
  const control = plugins?.querySelector<HTMLButtonElement>('.motion-control');
  if (plugins && control) {
    let paused = false;
    let visible = false;
    const update = () => { plugins.dataset.playing = String(visible && !paused); };
    control.hidden = false;
    control.addEventListener('click', () => {
      paused = !paused;
      control.textContent = paused ? 'Play illustrations' : 'Pause illustrations';
      update();
    });
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      update();
    }).observe(plugins);
  }
</script>
<style>
  .plugins { margin-top: 88px; scroll-margin-top: 32px; }
  .plugins-header { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 30px; }
  .plugins-header .kicker { margin: 0; }
  .plugins-header h2 { font-size: clamp(32px, 4vw, 48px); line-height: 1.1; margin: 16px 0; }
  .plugins-header p:not(.kicker) { max-width: 570px; color: var(--muted); line-height: 1.65; margin: 0; }
  .motion-control { flex-shrink: 0; background: none; color: var(--muted); border: 1px solid var(--line); border-radius: 6px; font: inherit; font-size: 12px; padding: 9px 12px; cursor: pointer; }
  .motion-control:hover { color: var(--ink); border-color: var(--accent); }
  .plugin-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
