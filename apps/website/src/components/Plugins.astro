  .plugin-copy { flex: 1; display: flex; flex-direction: column; align-items: start; padding: clamp(22px, 3vw, 34px); }
  .plugin-status { display: flex; align-items: center; gap: 8px; margin: 0; color: var(--muted); font: 11px/1.5 ui-monospace, monospace; }
  .available-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
