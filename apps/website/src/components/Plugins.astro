                <g class="todo-row plugin-motion">
                  <rect x="280" y="88" width="160" height="29" rx="4" fill="#d3e3c9" stroke="#94b18e" stroke-width="1" />
                  <rect x="290" y="97" width="11" height="11" rx="2" fill="#fafaf2" stroke="#537e57" stroke-width="1.5" />
                  <g fill="#214c3a" stroke="none" font-family="ui-sans-serif, system-ui, sans-serif" font-size="14">
                    <text class="todo-before plugin-motion" x="309" y="107">Buy milk</text>
                    <text class="todo-after changed-text plugin-motion" x="309" y="107">Buy oat milk</text>
                  </g>
                </g>
              </g>
            ))}
          </g>
          <g fill="#214c3a" font-family="ui-sans-serif, system-ui, sans-serif">
            <text x="88" y="70" font-size="15" font-weight="600">OPFS VFS</text>
            <text x="88" y="88" font-size="12" fill="#537e57">Shared volume</text>
            <text x="39" y="116" font-size="12">/todos</text>
            <g font-size="13" text-anchor="middle">
              <text class="phase-label phase-create plugin-motion" x="240" y="266">Create file → Notify both tabs</text>
              <text class="phase-label phase-update plugin-motion" x="240" y="266">Update file → Notify both tabs</text>
              <text class="phase-label phase-delete plugin-motion" x="240" y="266">Delete file → Notify both tabs</text>
              <text class="static-caption" x="240" y="266">One volume → Change events across tabs</text>
            </g>
          </g>
        </svg>
      </div>
      <div class="plugin-copy">
        <p class="plugin-status"><span class="available-dot" aria-hidden="true"></span>Available <span aria-hidden="true">·</span> Community</p>
        <h3 id="subscriptions-heading">File subscriptions plugin</h3>
        <p>Receive file change events across tabs using the same volume and origin. Reread affected paths to refresh your UI.</p>
