  .sync-plan { display: flex; align-items: center; gap: 24px; margin-top: 24px; padding: 26px 30px; border: 1px dashed var(--line); border-radius: 10px; }
  .sync-plan > svg { width: 48px; height: 48px; flex-shrink: 0; color: var(--accent); }
