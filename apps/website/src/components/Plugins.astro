    17%, 49%, 81%, 100% { opacity: 0; stroke-dashoffset: -122; }
  }
  @keyframes create-caption { 0% { opacity: 1; } 36% { opacity: 0; } }
  @keyframes update-caption { 0% { opacity: 0; } 36% { opacity: 1; } 70% { opacity: 0; } }
