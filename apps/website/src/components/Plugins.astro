  .sync-plan > a { flex-shrink: 0; }
  .changed-text, .phase-label, .event-path { opacity: 0; }
  [data-playing] .file-node { animation: file-lifetime 10s linear infinite; }
  [data-playing] .todo-row { animation: todo-lifetime 10s linear infinite; }
  [data-playing] .file-before { animation: old-text 10s steps(1) infinite; }
