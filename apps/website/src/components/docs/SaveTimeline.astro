  li::before { content: counter(save-step); position: absolute; left: -.8rem; top: 0; display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border: 1px solid var(--sl-color-text-accent); border-radius: 50%; background: var(--sl-color-bg); color: var(--sl-color-text-accent); font: .8rem var(--sl-font-mono); }
