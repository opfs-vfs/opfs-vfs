---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/Hero';
import Adapters from '../components/Adapters.astro';
import StorageBenefits from '../components/StorageBenefits.astro';
import ExportImportArt from '../components/ExportImportArt.astro';
import Plugins from '../components/Plugins.astro';
import Sdks from '../components/Sdks.astro';


---
<SiteLayout title="OPFS VFS · Synchronous browser filesystem for apps & agents" description="A virtual filesystem for the Origin Private File System. Store thousands of files in the browser with synchronous worker I/O. For TypeScript, React and Effect.">
  <Hero client:load />
  <section class="use-cases" aria-labelledby="use-cases-heading">
    <p class="kicker">Built around your files</p>
    <h2 id="use-cases-heading" aria-label="Your storage layer for browser agents, in-browser databases, code sandboxes, WASM runtimes, and private workspaces">
      Your storage layer for
      <span class="use-case-window" aria-hidden="true"><span class="use-case-track"><span>browser agents.</span><span>in-browser databases.</span><span>code sandboxes.</span><span>WASM runtimes.</span><span>private workspaces.</span><span>browser agents.</span></span></span>
    </h2>
    <p>Give browser tools and apps familiar paths to files that persist across sessions.</p>
  </section>
  <StorageBenefits />
  <Sdks />
  <Adapters />
  <section id="export-import" class="portability" aria-labelledby="portability-heading">
    <div class="portability-copy">
      <p class="kicker">Volume export &amp; import</p>
      <h2 id="portability-heading">Take your files<br />with you.</h2>
      <p>Export your workspace files and folders as a ZIP, then import them into a new volume. Keep a backup, share a project, or move your workspace to another browser.</p>
      <a class="button solid" href="/demos/filesystem/">Try export &amp; import <span aria-hidden="true">↗</span></a>
    </div>
    <div class="portability-detail">
      <ExportImportArt />
      <p>Working with PGlite? <a href="/demos/pglite/">Export and import its native database archives <span aria-hidden="true">↗</span></a></p>
    </div>
  </section>
  <section id="why-opfs" class="storage-intro" aria-labelledby="storage-heading">
    <div class="feature-copy">
      <p class="kicker">Why OPFS VFS</p>
      <h2 id="storage-heading">Thousands of paths.<br />A bounded set of handles.</h2>
      <p>Store many files without opening a native handle for each one. OPFS VFS manages the volume layout and gives your application synchronous file access inside a worker.</p>
      <a class="motivation-link" href="/motivation/">Why we built OPFS VFS →</a>
    </div>
    <img class="feature-art" src="/images/storage-paths.webp" alt="Many file and folder paths converge through a few connections into one storage volume." width="1536" height="1024" loading="lazy" decoding="async" />
  </section>
  <section id="privacy" class="storage-intro storage-intro-reversed" aria-labelledby="privacy-heading">
    <div class="feature-copy">
      <p class="kicker">Privacy-sensitive applications</p>
      <h2 id="privacy-heading">Keep sensitive files on the device.</h2>
      <p>Build document tools, local databases, and on-device AI workflows that process files in the browser. OPFS VFS stores those files locally, so your app can work with them without uploading their contents to a server.</p>
    </div>
    <img class="feature-art" src="/images/device-privacy.webp" alt="Documents, folders, and a database connected within a laptop's browser workspace." width="1536" height="1024" loading="lazy" decoding="async" />
  </section>
  <section class="file-reactivity" aria-labelledby="file-reactivity-heading">
    <div>
      <p class="kicker">Files as app state</p>
      <h2 id="file-reactivity-heading">You might not need a local database.</h2>
      <p>If your app works with documents, keep files as its source of truth. Subscribe to changes, reread affected paths, and update the UI. You may not need a separate local database or global state store.</p>
      <a href="/docs/plugins/subscriptions/">Explore file subscriptions →</a>
    </div>
    <ol class="file-reactivity-flow">
      <li><span>01</span><strong>Write a file</strong><code>/workspace/notes.md</code></li>
      <li><span>02</span><strong>Get a change event</strong><small>The subscription reports the path.</small></li>
      <li><span>03</span><strong>Reread and render</strong><small>The UI shows the current file.</small></li>
    </ol>
  </section>
  <Plugins />
  <section class="browser-support" aria-labelledby="browser-support-heading">
    <div class="browser-support-heading">
      <div><p class="kicker">Browser support</p><h2 id="browser-support-heading">Built for today's browsers.</h2></div>
      <p>OPFS VFS uses the origin-private file system and synchronous file access in a dedicated worker. These browsers provide the required APIs from the versions shown.</p>
    </div>
    <table>
      <thead><tr><th scope="col">Browser</th><th scope="col">Minimum API version</th></tr></thead>
      <tbody>
        <tr><th scope="row"><span class="browser-name"><img src="/brand/browsers/chrome.svg" alt="" width="42" height="42" loading="lazy" /><span>Chrome</span></span></th><td><strong>108+</strong><span>Desktop · Android 109+</span></td></tr>
        <tr><th scope="row"><span class="browser-name"><img src="/brand/browsers/edge.svg" alt="" width="42" height="42" loading="lazy" /><span>Edge</span></span></th><td><strong>108+</strong><span>Desktop</span></td></tr>
        <tr><th scope="row"><span class="browser-name"><img src="/brand/browsers/firefox.svg" alt="" width="42" height="42" loading="lazy" /><span>Firefox</span></span></th><td><strong>111+</strong><span>Desktop &amp; Android</span></td></tr>
        <tr><th scope="row"><span class="browser-name"><img src="/brand/browsers/safari.svg" alt="" width="42" height="42" loading="lazy" /><span>Safari</span></span></th><td><strong>16.4+</strong><span>macOS, iOS &amp; iPadOS</span></td></tr>
      </tbody>
    </table>
    <p class="browser-support-note">Version numbers reflect browser API availability, not a test guarantee for every release. Use HTTPS or localhost; the worker client also needs cross-origin isolation. <a href="/docs/guides/browser-setup/">Browser setup →</a></p>
  </section>
  <section class="benchmark-callout" aria-labelledby="benchmark-heading">
    <p class="kicker">Benchmarks</p>
    <h2 id="benchmark-heading">Compare storage performance.</h2>
    <p>Compare OPFS VFS with PGlite's OPFS AHP, IndexedDB, and memory-only backends. See the measured results, settings, and raw samples, or run the workloads on your device.</p>
    <img class="benchmark-art" src="/images/storage-comparison.webp" alt="A storage volume, folders, a database, and a memory module shown side by side." width="1536" height="1024" loading="lazy" decoding="async" />
    <a class="button" href="/benchmarks/">Benchmark overview →</a>
  </section>
  <section class="contact-callout" aria-labelledby="contact-heading">
    <p class="kicker">Start a conversation</p>
    <h2 id="contact-heading">Building something that needs a place for its files?</h2>
    <p>Tell us about it. We’d love to hear what you’re making with OPFS VFS.</p>
    <button class="button solid" type="button" data-contact-trigger>Contact us <span aria-hidden="true">→</span></button>
  </section>
</SiteLayout>
<style>
  .use-cases { padding: clamp(48px, 7vw, 88px) 0; border-top: 1px solid var(--line); }
  .use-cases .kicker, .file-reactivity .kicker { margin: 0 0 16px; }
  .use-cases h2 { max-width: 1100px; margin: 0; font-size: clamp(28px, 5.7vw, 68px); line-height: 1.05; }
  .use-case-window { display: block; height: 1.2em; overflow: hidden; color: var(--accent); }
  .use-case-track { display: block; animation: use-case-cycle 20s infinite; }
  .use-case-track > span { display: flex; align-items: center; height: 1.2em; white-space: nowrap; }
  .use-cases > p:last-child { max-width: 600px; margin: 24px 0 0; color: var(--muted); line-height: 1.65; }
  @keyframes use-case-cycle {
    0%, 16% { transform: translateY(0); }
    20%, 36% { transform: translateY(-1.2em); }
    40%, 56% { transform: translateY(-2.4em); }
    60%, 76% { transform: translateY(-3.6em); }
    80%, 96% { transform: translateY(-4.8em); }
    100% { transform: translateY(-6em); }
  }
  @media (prefers-reduced-motion: reduce) { .use-case-track { animation: none; } }
  .file-reactivity { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 88px); padding: 80px 0 0; margin-top: 88px; border-top: 1px solid var(--line); }
  .file-reactivity h2 { max-width: 570px; margin: 0 0 22px; font-size: clamp(36px, 4.5vw, 58px); line-height: 1.05; }
  .file-reactivity p:not(.kicker) { max-width: 540px; margin: 0 0 22px; color: var(--muted); line-height: 1.65; }
  .file-reactivity a { color: var(--accent); font-weight: 600; text-underline-offset: 5px; }
  .file-reactivity-flow { align-self: center; list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .file-reactivity-flow li { display: grid; grid-template-columns: 40px 1fr; gap: 3px 16px; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .file-reactivity-flow li > span { grid-row: span 2; color: var(--accent); font: 12px/1.7 ui-monospace, monospace; }
  .file-reactivity-flow strong { font-size: 18px; font-weight: 600; }
  .file-reactivity-flow :is(code, small) { color: var(--muted); font: 13px/1.5 ui-monospace, monospace; }
  .browser-support { margin-top: 88px; padding-top: 80px; border-top: 1px solid var(--line); }
  .browser-support-heading { display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: 48px; margin-bottom: 32px; }
  .browser-support .kicker { margin: 0 0 16px; }
  .browser-support h2 { margin: 0; font-size: clamp(36px, 4.5vw, 58px); line-height: 1.05; }
  .browser-support-heading > p { max-width: 500px; margin: 0; color: var(--muted); line-height: 1.65; }
  .browser-support table { width: 100%; border-collapse: collapse; text-align: left; }
  .browser-support :is(th, td) { border-bottom: 1px solid var(--line); }
  .browser-support thead th { padding: 14px 18px; border-top: 1px solid var(--line); color: var(--muted); font: 11px/1.5 ui-monospace, monospace; text-transform: uppercase; letter-spacing: .08em; }
  .browser-support tbody :is(th, td) { padding: 20px 18px; }
  .browser-name { display: flex; align-items: center; gap: 20px; font-size: 24px; font-weight: 600; letter-spacing: -.04em; }
  .browser-support tbody img { flex: none; width: 42px; height: 42px; object-fit: contain; }
  .browser-support tbody td strong { display: block; font-size: 22px; }
  .browser-support tbody td span { display: block; margin-top: 3px; color: var(--muted); font-size: 13px; }
  .browser-support-note { max-width: 760px; margin: 22px 0 0; color: var(--muted); font-size: 13px; line-height: 1.6; }
  .browser-support-note a { color: var(--accent); text-underline-offset: 4px; }
  .portability { scroll-margin-top: 32px; display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 55px; padding: 38px; margin-bottom: 54px; border: 1px solid var(--line); border-radius: 10px; background: var(--soft); }
  .portability .kicker { margin: 0 0 14px; }
  .portability h2 { margin: 0 0 18px; font-size: clamp(34px, 3.5vw, 48px); line-height: 1.04; }
  .portability-copy > p:not(.kicker) { max-width: 485px; color: var(--muted); font-size: 15px; line-height: 1.65; margin: 0 0 24px; }
  .portability .button { gap: 10px; }
  .portability-detail { min-width: 0; }
  .portability-detail > p { color: var(--muted); font-size: 12px; line-height: 1.6; margin: 20px 0 0; }
  .portability-detail a { color: var(--accent); text-underline-offset: 3px; }
  .portability-detail a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 900px) { .portability { gap: 30px; padding: 28px; } }
  @media (max-width: 700px) { .portability { grid-template-columns: 1fr; padding: 24px; gap: 32px; } }

  .storage-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(32px, 6vw, 88px); margin-top: 88px; scroll-margin-top: 32px; }
  .feature-copy { max-width: 520px; }
  .motivation-link { display: inline-block; margin-top: 18px; color: var(--accent); text-underline-offset: 4px; }
  .storage-intro h2 { font-size: clamp(30px, 3.5vw, 44px); line-height: 1.1; margin: 14px 0 22px; }
  .storage-intro p:not(.kicker) { color: var(--muted); line-height: 1.65; margin: 0; }
  .feature-art { display: block; width: 100%; height: auto; }
  .storage-intro-reversed .feature-art { grid-column: 1; grid-row: 1; }
  .storage-intro-reversed .feature-copy { grid-column: 2; grid-row: 1; justify-self: end; }
  .benchmark-callout { margin-top: 88px; padding: 64px 0 48px; display: flex; flex-direction: column; align-items: center; text-align: center; border-top: 1px solid var(--line); }
  .benchmark-callout .kicker { margin: 0; }
  .benchmark-callout h2 { font-size: clamp(32px, 4vw, 48px); line-height: 1.08; margin: 18px 0 22px; }
  .benchmark-callout p:not(.kicker) { max-width: 560px; color: var(--muted); line-height: 1.65; margin: 0; }
  .benchmark-art { display: block; width: min(100%, 840px); height: auto; aspect-ratio: 3 / 1; object-fit: cover; margin-top: 32px; }
  .benchmark-callout .button { margin-top: 28px; }
  .contact-callout { margin: 72px 0 0; padding: clamp(36px, 7vw, 80px); border: 1px solid var(--accent); border-radius: 12px; background: var(--primary-bg); color: var(--primary-fg); text-align: center; }
  .contact-callout .kicker { color: color-mix(in srgb, var(--primary-fg) 70%, transparent); }
  .contact-callout h2 { max-width: 720px; margin: 14px auto; font-size: clamp(32px, 4.8vw, 58px); line-height: 1.05; }
  .contact-callout p:not(.kicker) { max-width: 540px; margin: 0 auto; color: color-mix(in srgb, var(--primary-fg) 76%, transparent); line-height: 1.65; }
  .contact-callout .button { margin-top: 28px; border-color: var(--primary-fg); background: var(--primary-fg); color: var(--primary-bg); cursor: pointer; }
  @media (max-width: 700px) {
    .file-reactivity { grid-template-columns: 1fr; padding: 56px 0 0; margin-top: 56px; }
    .browser-support { margin-top: 56px; padding-top: 56px; }
    .browser-support-heading { grid-template-columns: 1fr; gap: 16px; }
    .browser-support thead th, .browser-support tbody :is(th, td) { padding-inline: 8px; }
    .browser-name { gap: 10px; font-size: 17px; }
    .browser-support tbody img { width: 32px; height: 32px; }
    .browser-support tbody td strong { font-size: 18px; }
    .browser-support tbody td span { font-size: 11px; }
    .storage-intro { grid-template-columns: minmax(0, 1fr); gap: 24px; margin-top: 56px; }
    .feature-copy { max-width: none; }
    .storage-intro-reversed .feature-art, .storage-intro-reversed .feature-copy { grid-column: auto; grid-row: auto; }
    .feature-art { max-width: 540px; justify-self: center; }
    .benchmark-callout { margin-top: 56px; padding: 44px 0 24px; }
  }
</style>
