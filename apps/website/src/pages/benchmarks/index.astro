---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PublishedBenchmarks from '../../components/PublishedBenchmarks.astro';
---
<SiteLayout title="Benchmarks · OPFS VFS" description="Compare measured OPFS VFS and PGlite storage performance, with raw samples, settings, and device details."><section class="page-head"><div><p class="kicker">Benchmarks</p><h1>Storage benchmarks</h1><p>Measured execution times for OPFS VFS, PGlite OPFS AHP, IndexedDB, and in-memory storage. Results include the workload, configuration, and test environment.</p></div><a class="button solid" href="/benchmarks/run/">Run on your device →</a></section><div class="collection-link"><a class="button" href="/benchmarks/collect/">Collect a full result set →</a></div><PublishedBenchmarks /><section class="storage-guide"><div><h2>Storage and durability</h2><p>How the backends store data and how buffering and durability settings affect persistence.</p></div><a class="button" href="/benchmarks/storage/">Read the storage guide →</a></section><section class="feature-grid"><article class="card"><h2>PGlite suite</h2><p>Compare OPFS VFS with PGlite's OPFS AHP, IndexedDB, and memory-only backends using the same SQL workload.</p></article><article class="card"><h2>Filesystem suite</h2><p>Create, read, write, rename, delete, flush, and reopen operations test filesystem behavior directly.</p><a href="/benchmarks/filesystem/">Run filesystem benchmarks →</a></article></section></SiteLayout>
<style>.collection-link{margin-bottom:32px}.storage-guide{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:24px;padding:32px 0;border-bottom:1px solid var(--line)}.storage-guide h2{font-size:24px;letter-spacing:-.025em;margin:0 0 12px}.storage-guide p{max-width:58ch;color:var(--muted);line-height:1.6;margin:0}.backend-table{overflow:auto;margin:0 0 30px}.backend-table table{border-collapse:collapse;width:100%;font-size:14px;text-align:left}.backend-table caption{text-align:left;padding:0 0 12px;font-weight:600}.backend-table th,.backend-table td{padding:14px;border-bottom:1px solid var(--line);line-height:1.5}.backend-table td{color:var(--muted)}.empty p{max-width:520px;line-height:1.6;margin:10px auto 20px;color:var(--muted)}</style>
