---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ReactSdkDemo from '../../components/ReactSdkDemo';
---
<SiteLayout title="React SDK demo · OPFS VFS" description="Keep local files and todo lists in sync across browser tabs with React.">
  <section class="page-head">
    <div>
      <p class="kicker">Demo / React SDK preview</p>
      <h1>Local files, live in every tab</h1>
      <p>Try a file inbox or Markdown-backed todo lists, then open either example in another tab to watch saved changes arrive through subscribed React reads.</p>
    </div>
    <a class="button" href="/docs/react/">React SDK guide →</a>
  </section>
  <ReactSdkDemo client:only="react" />
</SiteLayout>
