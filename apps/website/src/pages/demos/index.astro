---
import SiteLayout from '../../layouts/SiteLayout.astro';
const demos = [['Volume Explorer', 'Browse, edit, preview, and transfer volumes. Debug storage with a built-in shell.', '/demos/devtools/'], ['Filesystem', 'Create and edit files, run shell commands, and transfer a workspace as a ZIP.', '/demos/filesystem/'], ['React SDK (preview)', 'Keep a local file inbox in sync across browser tabs with the React SDK.', '/demos/react/'], ['PGlite', 'Query a persistent browser database and compare it with memory.', '/demos/pglite/'], ['DuckDB (experimental)', 'Analyze data with SQL and reopen tables saved in OPFS VFS.', '/demos/duckdb/'], ['EdgeJS (experimental)', 'Run JavaScript with node:fs and keep files across page reloads.', '/demos/edgejs/'], ['Local AI', 'Run Gemma on your device to create and organize workspace files.', '/demos/ai/']];
---
<SiteLayout title="Demos · OPFS VFS" description="Try OPFS VFS with files, SQL databases, JavaScript, developer tools, and a local AI model."><section class="page-head"><div><p class="kicker">Demos / explore locally</p><h1>Try OPFS VFS in your browser</h1><p>Try a file workspace, a persistent database, or a browser runtime. Each demo has its own browser storage.</p></div></section><section class="demos">{demos.map(([title, copy, href]) => <a href={href}><span class="kicker">Demo</span><h2>{title}</h2><p>{copy}</p><span>Open demo →</span></a>)}</section></SiteLayout>
<style>.demos{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));border-top:1px solid var(--line)}.demos a{padding:28px 22px 28px 0;text-decoration:none}.demos a{border-bottom:1px solid var(--line)}.demos h2{font-size:27px;margin:12px 0}.demos p{min-height:72px;color:var(--muted);font-size:14px;line-height:1.55}.demos span:last-child{color:var(--accent);font-size:13px;font-weight:600}@media(max-width:700px){.demos{grid-template-columns:1fr}.demos a+a{border-left:0;border-top:1px solid var(--line);padding-left:0}}</style>
