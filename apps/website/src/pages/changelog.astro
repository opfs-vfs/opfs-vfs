---
import SiteLayout from '../layouts/SiteLayout.astro';
import ReleaseNotes from '../components/ReleaseNotes';
import { fetchReleases } from '../lib/releases';

const releases = await fetchReleases(process.env.GITHUB_TOKEN);
const manifests = import.meta.glob<{ name: string; private?: boolean }>('../../../../packages/*/package.json', { eager: true, import: 'default' });
const priority = ['@opfs-vfs/react', '@opfs-vfs/effect'];
const packages = Object.entries(manifests).filter(([, pkg]) => !pkg.private).map(([path, pkg]) => ({
  name: pkg.name,
  directory: path.split('/').at(-2)!,
  releases: releases.filter((release) => release.packageName === pkg.name).slice(0, 1),
})).sort((a, b) => (priority.indexOf(a.name) + 1 || 3) - (priority.indexOf(b.name) + 1 || 3) || a.name.localeCompare(b.name));
---
<SiteLayout title="Changelog · OPFS VFS" description="Latest release notes for every OPFS VFS package, including the React SDK, Effect adapter, core filesystem, plugins, and devtools.">
  <section class="page-head"><div><p class="kicker">Changelog / package releases</p><h1>What changed</h1><p>The latest published release of each package, with notes generated from Changesets. Browse each package’s full changelog for older releases.</p></div><a class="button" href="https://github.com/opfs-vfs/opfs-vfs/releases">View GitHub releases ↗</a></section>
  <nav aria-label="Packages" class="package-links">{packages.map((pkg) => <a href={`#${pkg.directory}`}>{pkg.name}</a>)}</nav>
  <div class="releases">{packages.map((pkg) => <section id={pkg.directory} aria-labelledby={`${pkg.directory}-heading`}>
    <h2 id={`${pkg.directory}-heading`}>{pkg.name}</h2>
    <a href={`https://github.com/opfs-vfs/opfs-vfs/blob/main/packages/${pkg.directory}/CHANGELOG.md`}>Full package changelog ↗</a>
    {pkg.releases.length === 0 && <p>No GitHub releases published yet. See the package changelog for its history.</p>}
    {pkg.releases.map((release) => <article id={`${pkg.directory}-${release.version}`}>
      <div><h3><a href={release.url}>{release.version} ↗</a></h3><time datetime={release.publishedAt}>{release.publishedAt.slice(0, 10)}</time></div>
      <div class="release-notes"><ReleaseNotes body={release.body} /></div>
    </article>)}
  </section>)}</div>
</SiteLayout>
<style>
.package-links{display:flex;flex-wrap:wrap;gap:12px 24px;margin-bottom:40px}.releases{max-width:900px}.releases section{margin-bottom:48px;scroll-margin-top:100px}.releases h2{overflow-wrap:anywhere}.releases article{display:grid;grid-template-columns:150px minmax(0,1fr);gap:30px;padding:28px 0;border-top:1px solid var(--line);margin-top:20px}.releases h3{margin:0;font-size:27px}.releases time{color:var(--muted);font-size:12px}.release-notes{color:var(--muted);font-size:14px;line-height:1.65;overflow-wrap:anywhere}.release-notes :global(h3){margin-top:0;color:var(--ink);font-size:18px}.release-notes :global(code){overflow-wrap:anywhere}@media(max-width:600px){.releases article{grid-template-columns:1fr;gap:10px}}
</style>
