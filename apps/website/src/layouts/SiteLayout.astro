---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { Icon } from '@astrojs/starlight/components';
import ThemeControl from '../components/ThemeControl.astro';
import Brand from '../components/Brand.astro';
import SocialImage from '../components/SocialImage.astro';
import SiteIcons from '../components/SiteIcons.astro';
import ContactDialog from '../components/ContactDialog';
interface Props { title?: string; description: string; noindex?: boolean }
const { title = 'OPFS VFS', description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const links = [['/#sdks', 'SDKs & adapters'], ['/#plugins', 'Plugins'], ['/motivation/', 'Why OPFS VFS'], ['/demos/', 'Demos'], ['/benchmarks/', 'Benchmarks'], ['/docs/', 'Docs'], ['/changelog/', 'Changelog']];
const activeLink = links.find(([href]) => href !== '/#plugins' && Astro.url.pathname.startsWith(href))?.[0];
---
<!doctype html>
<html lang="en" class="marketing-page">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="theme-color" content="#fbfaf5" /><meta name="description" content={description} /><title>{title}</title>
    <SiteIcons />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OPFS VFS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <SocialImage />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="describedby" href="/llms.txt" type="text/markdown" />
    <Analytics />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <script is:inline>
      (() => {
        let stored;
        try { stored = localStorage.getItem('starlight-theme'); } catch {}
        document.documentElement.dataset.theme = stored === 'light' || stored === 'dark' ? stored : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="shell site-header">
      <Brand />
      <nav class="site-nav" aria-label="Primary">{links.map(([href, label]) => <a href={href} aria-current={href === activeLink ? 'page' : undefined}>{label}</a>)}</nav>
      <details class="mobile-navigation">
        <summary role="button" aria-label="Menu" title="Menu" aria-expanded="false" aria-controls="mobile-nav"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path class="menu-bars" d="M4 6h16M4 12h16M4 18h16" /><path class="menu-close" d="m6 6 12 12M6 18 18 6" /></svg></summary>
        <nav id="mobile-nav" class="mobile-nav" aria-label="Primary">
          {links.map(([href, label]) => <a href={href} aria-current={href === activeLink ? 'page' : undefined}>{label}</a>)}
          <button type="button" data-contact-trigger>Contact</button>
          <a href="https://github.com/opfs-vfs/opfs-vfs">GitHub ↗</a>
        </nav>
      </details>
      <a class="github" href="https://github.com/opfs-vfs/opfs-vfs" aria-label="GitHub repository" title="GitHub repository"><Icon name="github" size="22px" /></a>
      <ThemeControl />
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="shell site-footer"><span><a href="/licensing/">Noncommercial licensing</a> · source-available</span><span><a href="/sitemap/">Sitemap</a> · <a href="/llms.txt">llms.txt</a></span></footer>
    <ContactDialog client:load />
  </body>
</html>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const anchorLinks = ['plugins', 'sdks'].map((id) => ({
    section: document.getElementById(id),
    links: header?.querySelectorAll<HTMLAnchorElement>(`a[href="/#${id}"]`),
  }));
  const updateHeader = () => {
    header?.toggleAttribute('data-scrolled', window.scrollY > 8);
    for (const { section, links } of anchorLinks) {
      if (!section || !links) continue;
      const bounds = section.getBoundingClientRect();
      const active = bounds.top <= window.innerHeight * .4 && bounds.bottom > window.innerHeight * .4;
      links.forEach((link) => active ? link.setAttribute('aria-current', 'location') : link.removeAttribute('aria-current'));
    }
  };
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-navigation');
  document.querySelectorAll<HTMLElement>('[data-contact-trigger]').forEach((trigger) => trigger.addEventListener('click', () => {
    if (menu) menu.open = false;
    window.dispatchEvent(new CustomEvent('opfs:contact', { detail: trigger }));
  }));
  if (menu) {
    menu.addEventListener('toggle', () => menu.querySelector('summary')?.setAttribute('aria-expanded', String(menu.open)));
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
      if (event.target instanceof Element && event.target.closest('.mobile-nav a')) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
